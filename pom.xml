<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ============================== Metadata ============================== -->
    <groupId>ar.edu.unicen.exa.alumnos.matias.victoriano</groupId>
    <artifactId>flc-iec61131-7-compiler</artifactId>
    <version>1.0-SNAPSHOT</version>

    <!-- ============================= Properties ============================= -->
    <properties>
        <!-- Compilation -->
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Plugin versions -->
        <surefire.version>3.5.2</surefire.version>
        <jflex.plugin.version>1.9.1</jflex.plugin.version>
        <checkstyle.plugin.version>3.3.1</checkstyle.plugin.version>
        <checkstyle.version>3.6.0</checkstyle.version>
        <spotbugs.plugin.version>4.8.3.1</spotbugs.plugin.version>
        <jacoco.plugin.version>0.8.12</jacoco.plugin.version>
        <sonar.plugin.version>4.0.0.4121</sonar.plugin.version>

        <!-- Plugin Annotation Versions -->
        <spotbugs.annotations.version>4.8.3</spotbugs.annotations.version>

        <!-- Test dependencies versions -->
        <junit.version>5.11.4</junit.version>
        <mockito.version>3.12.4</mockito.version>

        <!-- ================= SonarQube & Coverage Properties ================= -->
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>**/Parser.java,**/Lexer.java,**/LucaInfo.java</sonar.exclusions>
        <sonar.coverage.exclusions>**/Parser.java,**/Lexer.java,**/LucaInfo.java</sonar.coverage.exclusions>
    </properties>

    <!-- ============================ Dependencies ============================ -->
    <dependencies>
        <!-- Nullability annotations (@Nullable / @NonNull) -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- SpotBugs Annotations: Used for @SuppressFBWarnings -->
        <dependency>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-annotations</artifactId>
            <version>${spotbugs.annotations.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JUnit 5: Testing framework -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Mockito: Mocking framework for tests -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Surefire: Executes tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>

            <!-- JaCoCo: Analiza y genera el reporte de cobertura de código para SonarQube -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.plugin.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- SonarQube Plugin -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.plugin.version}</version>
            </plugin>

            <!-- JFlex: Generates the Java lexer -->
            <plugin>
                <groupId>de.jflex</groupId>
                <artifactId>jflex-maven-plugin</artifactId>
                <version>${jflex.plugin.version}</version>
                <configuration>
                    <lexDefinitions>
                        <lexDefinition>src/main/java/lexer/Lexer.flex</lexDefinition>
                    </lexDefinitions>
                    <outputDirectory>src/main/java</outputDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Checkstyle -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${checkstyle.plugin.version}</version>
                <configuration>
                    <configLocation>config/checkstyle/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failsOnError>true</failsOnError>
                    <failOnViolation>true</failOnViolation>
                    <maxAllowedViolations>100</maxAllowedViolations>
                    <violationSeverity>error</violationSeverity>
                    <excludes>**/Parser.java,**/Lexer.java,**/LucaInfo.java</excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>validate-checkstyle</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- SpotBugs -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.plugin.version}</version>
                <configuration>
                    <threshold>Medium</threshold>
                    <maxAllowedViolations>5</maxAllowedViolations>
                    <failThreshold>Medium</failThreshold>
                    <failOnError>true</failOnError>
                    <excludeFilterFile>config/spotbugs/excludeFilter.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>validate-spotbugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>