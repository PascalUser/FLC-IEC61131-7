classDiagram
    namespace simulation {
        class ReferenceSimulator {
            -model ControllerModel
            +ReferenceSimulator(ControllerModel)
            +evaluate(double...) double[]
            -centroid(Variable, double[]) double
        }
        class QuantizedSimulator {
            -model ControllerModel
            -degreeTables double[][][]
            +QuantizedSimulator(ControllerModel)
            +evaluate(int...) OptionalInt[]
            -centroid(Variable, double[]) OptionalInt
        }
        class SimulationComparison {
            <<utility>>
            +compare(ControllerModel, int) List~OutputComparison~
            -next(int[], int, int) boolean
        }
        class OutputComparison {
            -output String
            -evaluated long
            -maxError double
            -worstInputs int[]
            -meanError double
            -undefinedInHardware long
            -undefinedInReference long
            +output() String
            +evaluated() long
            +maxError() double
            +worstInputs() int[]
            +meanError() double
            +undefinedInHardware() long
            +undefinedInReference() long
        }
        class MinMaxEvaluation {
            <<utility>>
            ~requireSimulable(ControllerModel) void
            ~outputDegrees(ControllerModel, double[][]) double[][]
        }
    }
    namespace generator {
        class ControllerModel
        class Variable
    }
    namespace codegen_evaluation {
        class EvaluationMethod
        class MinMaxMethod
    }
    namespace codegen_defuzzification {
        class CentroidDefuzzifier
    }
    namespace codegen_fuzzysets {
        class FuzzySet
        class SingletonFuzzySet
    }
