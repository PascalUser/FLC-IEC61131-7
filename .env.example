# ==============================================================================
# 1. DOCKER & HOST PERMISSIONS
# ==============================================================================
# User mapping to maintain file permission consistency between host and container.
# Copy this file to `.env` and adjust if your host UID/GID differs from 1000
# (check your values with `id -u` and `id -g`).
UID=1000
GID=1000

# ==============================================================================
# 2. LLM PROVIDERS (OpenCode / AI Agents)
# ==============================================================================
# Configure at least one of the following providers depending on the models
# defined in `opencode.json`. Leave unused keys blank.

# Google AI Studio (required for `google/*` models)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter (required for `openrouter/*` models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ==============================================================================
# 3. HARNESS & RATE LIMITING
# ==============================================================================
# Minimum delay (in milliseconds) between consecutive agent calls per model
# to prevent hitting provider RPM/TPM rate limits. Wrap JSON in single quotes.
FLC_LLM_MODEL_INTERVALS_JSON='{"gemini-3.6-flash":16000,"gemini-3.5-flash":25000}'
