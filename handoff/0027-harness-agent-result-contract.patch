+AGENT_RESULT_PREFIX = "HARNESS_RESULT_JSON:"
+AGENT_OUTCOMES = {"NO_CHANGES", "PATCH_PROPOSED", "BLOCKED"}
+PATCH_METADATA_FIELDS = (
+    "id", "objective", "motivation", "scope", "changes",
