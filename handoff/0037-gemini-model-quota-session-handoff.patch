+                             "ses_abc123456789")
+            self.assertIsNone(store.load("docs_update_parser", cmd, "source-b"))
+            self.assertIsNone(store.load("docs_update_parser", cmd+["new"], "source-a"))
+            store.save("docs_update_parser", cmd, "source-a", "ses_abc123456789",
