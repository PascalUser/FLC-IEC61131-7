+    results = {}
+    pending = {}
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        for name, generator in sorted(diagrams.items()):
+            path = root / 'doc' / 'diagrams' / (name + '.mmd')
+            try:
+                expected = generator()
+                if not isinstance(expected, str) or not expected.strip():
+                    results[name] = ('FAILED', 'generator produced empty or non-text content')
+                    continue
+                if not path.is_file():
+                    results[name] = ('MISSING', str(path))
+                    continue
+                actual = path.read_text(encoding='utf-8')
+                if actual != expected:
+                    results[name] = ('STALE', 'differs from current source')
+                    continue
+                if not cli or not chrome:
+                    results[name] = ('UNAVAILABLE', 'Mermaid CLI or headless Chromium missing')
+                    continue
+                pending[name] = executor.submit(_render_mermaid, actual, cli, chrome)
+            except (OSError, UnicodeError, ValueError) as exc:
+                results[name] = ('FAILED', f'{type(exc).__name__}: {exc}')
+            except Exception as exc:
+                results[name] = ('FAILED', f'{type(exc).__name__}: {exc}')
+        for name, future in pending.items():
+            detail = future.result()
+            results[name] = ('INVALID' if detail else 'OK', detail or '')
+    return [(name, *results[name]) for name in sorted(results)]
 
