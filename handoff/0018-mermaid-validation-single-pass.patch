+def inspect_diagrams(root=None, diagrams=None, cli=None, chrome=None):
+    """Return (name, status, detail) once per diagram; never write tracked files.
+
+    Generator failures, missing files, and stale files are definitive; do not
+    spend time rendering them. Current diagrams are rendered in two workers to
+    avoid 27 sequential Chromium startups without overloading the container.
+    """
+    from concurrent.futures import ThreadPoolExecutor
+
     root = Path(root) if root is not None else generate_diagrams.ROOT
     diagrams = generate_diagrams.DIAGRAMS if diagrams is None else diagrams
     cli = shutil.which('mmdc') if cli is None else cli
     chrome = find_chrome_executable() if chrome is None else chrome
