diff --git a/src/main/java/compiler/package-info.java b/src/main/java/compiler/package-info.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/compiler/package-info.java
@@ -0,0 +1,13 @@
+/**
+ * Coordinates the end-to-end FCL compilation pipeline and exposes its
+ * in-memory generated-file result.
+ *
+ * <p>This package is the application orchestration boundary. The lexical,
+ * syntactic, AST, repository and target-generation responsibilities live in
+ * their respective sibling packages. {@link compiler.FlcCompiler} wires those
+ * phases; it is not itself a language-processing phase.</p>
+ *
+ * @see compiler.FlcCompiler
+ * @see compiler.GeneratedFile
+ */
+package compiler;
diff --git a/src/main/java/compiler/lexer/package-info.java b/src/main/java/compiler/lexer/package-info.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/compiler/lexer/package-info.java
@@ -0,0 +1,12 @@
+/**
+ * Lexical analysis for Fuzzy Control Language source text.
+ *
+ * <p>The lexer recognizes tokens, normalizes lexical representations through
+ * transformer chains, validates literal forms and publishes lexical
+ * information to the shared {@link compiler.repository.SymbolTable}.
+ * Lexical diagnostics are accumulated by
+ * {@link compiler.repository.DiagnosticsHandler}.</p>
+ *
+ * @see compiler.lexer.Lexer
+ */
+package compiler.lexer;
diff --git a/src/main/java/compiler/parser/package-info.java b/src/main/java/compiler/parser/package-info.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/compiler/parser/package-info.java
@@ -0,0 +1,13 @@
+/**
+ * Grammar-driven syntactic and declaration processing for FCL.
+ *
+ * <p>The parser consumes tokens from {@link compiler.lexer.Lexer}, applies
+ * the grammar and its semantic actions, publishes declaration metadata to
+ * {@link compiler.repository.SymbolTable}, and constructs the rule-block
+ * representation in {@link compiler.ast.AbstractSyntaxTree}. Supporting
+ * metadata, publishers, initialization strategies, semantic checks and
+ * focused facades are organized in subpackages.</p>
+ *
+ * @see compiler.parser.Parser
+ */
+package compiler.parser;
diff --git a/src/main/java/compiler/generator/package-info.java b/src/main/java/compiler/generator/package-info.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/compiler/generator/package-info.java
@@ -0,0 +1,15 @@
+/**
+ * Target controller model and code generation.
+ *
+ * <p>This package contains the model consumed by the C++ writer, fuzzy-set
+ * representations, evaluation and defuzzification strategies, and the
+ * generator itself. Source-language declarations and the rule-block AST are
+ * transformed into the target-oriented model by the {@code lowers}
+ * subpackage ({@link compiler.generator.lowers.ControllerLower}). Keeping
+ * lowering here makes it part of the generator boundary rather than a
+ * separate top-level production module.</p>
+ *
+ * @see compiler.generator.ControllerModel
+ * @see compiler.generator.CodeGenerator
+ */
+package compiler.generator;
diff --git a/src/main/java/compiler/ast/package-info.java b/src/main/java/compiler/ast/package-info.java
new file mode 100644
--- /dev/null
+++ b/src/main/java/compiler/ast/package-info.java
@@ -0,0 +1,11 @@
+/**
+ * Abstract syntax tree structures for parsed FCL rule blocks.
+ *
+ * <p>The AST preserves the rule-block structure needed by lowering without
+ * making the target C++ representation part of the parser's syntax model.
+ * The root is {@link compiler.ast.AbstractSyntaxTree}; its rule-block nodes
+ * and operator nodes are organized in subpackages.</p>
+ *
+ * @see compiler.ast.AbstractSyntaxTree
+ */
+package compiler.ast;
diff --git a/src/main/java/compiler/repository/package-info.java b/src/main/java/compiler/repository/package-info.java
