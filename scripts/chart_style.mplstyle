# Matplotlib style for FLC-IEC61131-7 thesis charts
# Apply with: plt.style.use('scripts/chart_style.mplstyle')

# Figure
figure.figsize: 8, 5
figure.dpi: 200
figure.facecolor: white
figure.edgecolor: white
figure.autolayout: True

# Font
font.family: DejaVu Sans
font.size: 11
axes.titlesize: 14
axes.labelsize: 12
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10
figure.titlesize: 16

# Axes
axes.facecolor: white
axes.edgecolor: #333333
axes.linewidth: 1.0
axes.grid: True
axes.grid.axis: y
axes.grid.which: major
axes.axisbelow: True
grid.color: #cccccc
grid.linewidth: 0.7
grid.linestyle: --

# Colors - thesis palette
axes.prop_cycle: cycler('color', ['#2C3E50', '#E74C3C', '#27AE60', '#F39C12', '#8E44AD', '#3498DB', '#E67E22', '#1ABC9C', '#95A5A6', '#34495E'])

# Lines
lines.linewidth: 2.0
lines.markersize: 6

# Bars
patch.linewidth: 0.5
patch.edgecolor: #333333

# Ticks
xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4
xtick.minor.size: 2
ytick.minor.size: 2

# Legend
legend.frameon: True
legend.framealpha: 0.9
legend.facecolor: white
legend.edgecolor: #cccccc
legend.fancybox: True

# Text
text.color: #2C3E50
axes.titlecolor: #2C3E50
axes.labelcolor: #34495E

# Savefig
savefig.facecolor: white
savefig.edgecolor: white
savefig.dpi: 200
savefig.bbox: tight
savefig.pad_inches: 0.1