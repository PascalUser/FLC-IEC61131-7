# Matplotlib style for FLC-IEC61131-7 thesis charts
# Apply with: plt.style.use('scripts/chart_style.mplstyle')

# Figure
figure.figsize: 8, 5
figure.dpi: 200
figure.facecolor: white
figure.edgecolor: white
figure.autolayout: True

# Font
font.family: DejaVu Sans
font.size: 11
axes.titlesize: 14
axes.labelsize: 12
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10
figure.titlesize: 16

# Axes
axes.facecolor: white
axes.edgecolor: 0.2
axes.linewidth: 1.0
axes.grid: True
axes.grid.axis: y
axes.grid.which: major
axes.axisbelow: True
grid.color: 0.8
grid.linewidth: 0.7
grid.linestyle: --

# Colors - thesis palette (using matplotlib color names or valid formats)
axes.prop_cycle: cycler('color', ['darkslategray', 'firebrick', 'forestgreen', 'goldenrod', 'mediumorchid', 'royalblue', 'chocolate', 'mediumturquoise', 'darkgray', 'darkslateblue'])

# Lines
lines.linewidth: 2.0
lines.markersize: 6

# Bars
patch.linewidth: 0.5
patch.edgecolor: 0.2

# Ticks
xtick.direction: out
ytick.direction: out
xtick.major.size: 4
ytick.major.size: 4
xtick.minor.size: 2
ytick.minor.size: 2

# Legend
legend.frameon: True
legend.framealpha: 0.9
legend.facecolor: white
legend.edgecolor: 0.8
legend.fancybox: True

# Text - using named colors
text.color: darkslategray
axes.titlecolor: darkslategray
axes.labelcolor: darkslategray

# Savefig
savefig.facecolor: white
savefig.edgecolor: white
savefig.dpi: 200
savefig.bbox: tight
savefig.pad_inches: 0.1